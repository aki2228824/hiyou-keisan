# Dify ワークフローAPI（週次使用量レポートの送信先）
DIFY_API_URL=https://api.dify.ai/v1/workflows/run
DIFY_API_KEY=app-xxxxxxxxxxxx

# 週次エクスポート設定
EXPORT_ENABLED=true
EXPORT_CRON=0 6 * * 1
EXPORT_DRY_RUN=false

TZ=Asia/Tokyo

# ---- サーバー設定（任意。使う場合は行頭の # を外す） ----

# ログイン状態（セッション）の署名に使う秘密の文字列。
# 本番運用では推測されにくい長いランダム文字列を必ず設定する。
# 変更すると全員が再ログインになる。
# SESSION_SECRET=ここに長いランダム文字列を設定

# 待ち受けポート番号（未設定時は 3000）
# PORT=3000

# データベースファイルの保存先（未設定時は data/hiyou.db）。
# サーバー機のローカルディスク上のパスを指定する。
# DB_PATH=C:/hiyou/data/hiyou.db

# 請求書PDFを同時に生成する数の上限（未設定時は 2）。超えた分は順番待ちになる。
# PDF 1件ごとに Chrome を起動して数百MBのメモリを使うため、メモリの少ないサーバーでは 1 にする。
# PDF_CONCURRENCY=2

# ---- HTTPS（リバースプロキシ）の背後で動かすとき（任意。手順は 配置手順/2_運用編.md の 3章） ----

# プロキシが伝える「HTTPSで届いた」「本当の接続元」という情報を信用する相手。
#   同じ機械の上の Caddy などから受ける場合 … loopback
#   NAS 内蔵のリバースプロキシ → コンテナの場合 … 1
# 未設定なら何も信用しない（プロキシを使わない構成では、設定しないこと）。
# TRUST_PROXY=loopback

# 待ち受けるアドレス。127.0.0.1 にすると、同じ機械のリバースプロキシ経由でしか接続できなくなる。
# 未設定なら従来どおり、すべてのネットワークで待ち受ける。
# HOST=127.0.0.1

# ---- ログインとパスワード（任意。未設定なら下に書いた既定値） ----

# パスワードの最小文字数（既定 13。8 未満にはできない）。
# 13 は、二要素認証を使わない場合に厚生労働省のガイドラインが求める桁数。
# PASSWORD_MIN_LENGTH=13

# 同じ接続元（PC）から、同じユーザーIDでログインに続けて失敗できる回数（既定 5。3〜20）と、
# その回数に達したときに、その接続元からログインできなくなる時間（分。既定 15。1〜1440）。
# 接続元を変えながら失敗を続けた場合は、合計がこの回数の 4 倍に達すると、どの接続元からもログインできなくなる。
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# ---- 操作ログ（任意） ----

# 操作ログ（audit-YYYY-MM.jsonl）の保存先フォルダ。
# 未設定なら、データベースファイルと同じフォルダの audit（例 C:/hiyou/data/audit）。通常は設定しない。
# AUDIT_LOG_DIR=C:/hiyou/data/audit
