# C:\hiyou\app\.env （サーバー機用）
# 開発PCの .env から DIFY_* の値を写し、下の3行（SESSION_SECRET / PORT / DB_PATH）を追加する。
# 変更したら Restart-Service hiyoukeisan で反映。

# ---- 週次使用量レポート（送信先） ----
DIFY_API_URL=https://api.dify.ai/v1/workflows/run
DIFY_API_KEY=app-xxxxxxxxxxxx

# ---- 週次エクスポート設定（true にするのは本番サーバー1台だけ） ----
EXPORT_ENABLED=true
EXPORT_CRON=0 6 * * 1
EXPORT_DRY_RUN=false

TZ=Asia/Tokyo

# ---- サーバー設定 ----
# 下のコマンドで作った 64 文字をそのまま貼る（引用符は付けない）:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ここに64文字のランダム文字列

PORT=3000

# DB はコードのフォルダの外に置く（区切りは / で書く）
DB_PATH=C:/hiyou/data/hiyou.db

# ---- ここから下は任意（書かなければ既定値で動く） ----

# HTTPS にするとき（Caddy を同じ機械で動かす。2_運用編.md の 3章）だけ、下の2行の # を外す
# TRUST_PROXY=loopback
# HOST=127.0.0.1

# パスワードの最小文字数（既定 13）、同じPCからのログイン失敗でロックするまでの回数（既定 5）、ロックする時間（分。既定 15）
# PASSWORD_MIN_LENGTH=13
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# 操作ログの保存先。書かなければ DB と同じフォルダの audit（C:/hiyou/data/audit）になる。通常は書かない
# AUDIT_LOG_DIR=C:/hiyou/data/audit
